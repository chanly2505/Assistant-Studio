# YouTube Studio Assistant — environment variables
#
# NAMES ONLY. Never commit real values to this file.
# Copy to `.env` and fill in locally:  cp .env.example .env
#
# Validation lives in src/lib/env.ts. A missing or malformed variable crashes the
# process at boot with a clear message rather than failing inside a request.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev uses the embedded PostgreSQL 16 started by `pnpm db:start` (port 5433).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/studio_assistant
# Pooled deployments (PgBouncer/Neon) need a direct, unpooled URL for migrations.
# DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication (Phase 3) — required in production
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# One OAuth client ("Web application") serves both grants. Register BOTH
# redirect URIs on it in Google Cloud Console:
#   ${APP_URL}/api/auth/callback/google      (sign-in)
#   ${APP_URL}/api/youtube/oauth/callback    (channel connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# YouTube OAuth (Phase 3) — the channel-connect grant, separate from login
# ---------------------------------------------------------------------------
# Defaults to ${APP_URL}/api/youtube/oauth/callback when unset.
# YOUTUBE_OAUTH_REDIRECT_URI=
# Daily YouTube Data API quota for THIS Google Cloud project (project-wide, not per user).
YOUTUBE_DATA_DAILY_QUOTA=10000

# ---------------------------------------------------------------------------
# Token encryption (Phase 3) — required in production
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Back this up SEPARATELY from the database. Losing it means every user must
# reconnect their channel; storing it beside the data defeats the encryption.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# During rotation only: the outgoing key as "<version>:<base64>". Rows sealed
# with it are re-encrypted under the current key the next time they are used.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# AI (Phase 6)
# ---------------------------------------------------------------------------
# "mock" is rejected when NODE_ENV=production.
AI_PROVIDER=mock
OPENAI_API_KEY=
# Global daily spend circuit breaker, in micros (1_000_000 = 1 USD).
AI_DAILY_SPEND_LIMIT_MICROS=50000000

# ---------------------------------------------------------------------------
# Redis (Phase 4) — optional in development, required in production
# ---------------------------------------------------------------------------
# Without it, rate limiting falls back to an in-memory store that is correct
# only for a single process.
# REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
