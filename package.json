{
  "name": "youtube-studio-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server --env-file=.env src/worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server --env-file=.env src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:start": "tsx scripts/db.mts start",
    "db:stop": "tsx scripts/db.mts stop",
    "db:status": "tsx scripts/db.mts status",
    "db:nuke": "tsx scripts/db.mts nuke",
    "redis:start": "tsx scripts/redis.mts start",
    "redis:stop": "tsx scripts/redis.mts stop",
    "redis:status": "tsx scripts/redis.mts status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.2.1",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "next": "15.1.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "3.26.3",
    "pino": "9.6.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@types/node": "22.10.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-boundaries": "5.0.1",
    "msw": "2.15.0",
    "pg": "8.23.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "prisma": "6.2.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.8"
  }
}
